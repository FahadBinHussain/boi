{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.local/schema/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "required": ["id", "source", "retrieved_at", "record_type"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "url": { "type": ["string", "null"] },
    "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "raw_path": { "type": ["string", "null"] },
    "external_id": { "type": ["string", "null"] },
    "record_type": {
      "type": "string",
      "enum": ["author", "book", "work", "edition", "catalog", "page", "dataset", "unknown"]
    },
    "raw_title": { "type": ["string", "null"] },
    "raw_author": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
