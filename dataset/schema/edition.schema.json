{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.local/schema/edition.schema.json",
  "title": "Edition",
  "type": "object",
  "required": ["id", "work_id", "title_as_printed", "source_refs", "confidence"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "title_as_printed": { "type": "string", "minLength": 1 },
    "publisher": { "type": ["string", "null"] },
    "publication_year": { "type": ["integer", "null"] },
    "isbn": { "type": ["string", "null"] },
    "pages": { "type": ["integer", "null"] },
    "format": { "type": ["string", "null"] },
    "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
