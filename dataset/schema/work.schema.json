{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.local/schema/work.schema.json",
  "title": "Work",
  "type": "object",
  "required": ["id", "language", "aliases", "source_refs", "confidence"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title_bn": { "type": ["string", "null"] },
    "title_en": { "type": ["string", "null"] },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "minLength": 1 },
    "genre": { "type": ["string", "null"] },
    "first_published_year": { "type": ["integer", "null"] },
    "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
