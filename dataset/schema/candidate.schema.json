{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.local/schema/candidate.schema.json",
  "title": "CandidateRecord",
  "type": "object",
  "required": ["id", "verification_status", "sources"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "verification_status": {
      "type": "string",
      "enum": ["pending", "verified", "rejected"]
    },
    "reason": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url", "retrieved_at", "notes"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
