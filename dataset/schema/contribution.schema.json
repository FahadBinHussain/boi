{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boi.local/schema/contribution.schema.json",
  "title": "Contribution",
  "type": "object",
  "required": ["id", "work_id", "author_id", "role", "source_refs", "confidence"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "work_id": { "type": "string", "minLength": 1 },
    "edition_id": { "type": ["string", "null"] },
    "author_id": { "type": "string", "minLength": 1 },
    "role": {
      "type": "string",
      "enum": ["author", "editor", "translator", "adapter", "compiler", "illustrator", "unknown"]
    },
    "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
