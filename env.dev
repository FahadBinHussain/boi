# Local development environment for boi
# Copy values from your providers and keep this file out of version control.

# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boi_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"