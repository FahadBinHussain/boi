# Copy to .env.local and fill in. The dataset page reads the live dataset from a
# Turso (libSQL) database; the app only ever needs the read-only values below.
#
# database build/admin (local scripts only, never needed by the deployed app):
#   TURSO_ADMIN_TOKEN     database token with full access (pnpm dataset:db:upload)
#   TURSO_PLATFORM_TOKEN  Turso platform API token (provisioning databases)
# See dataset/scripts/build-dataset-db.mjs and upload-dataset-db.mjs.

# https://<database>-<org>.<region>.turso.io
TURSO_DATABASE_URL=

# read-only database token: the deployed app physically cannot write
TURSO_AUTH_TOKEN=
